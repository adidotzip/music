{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Adi Music",
  "version": "0.0.1",
  "identifier": "space.imreallyadi.music",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Adi Music",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "A modern local music player",
    "longDescription": "Adi Music is a modern local music player for desktop and Android."
  }
}
